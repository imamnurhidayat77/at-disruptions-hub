# SAP integration (course API pool) — copy to .env.local and fill in.
# Never commit real values. The dev-server proxy reads these server-side;
# they are never bundled into frontend code.
SAP_API_BASE_URL=
SAP_API_KEY=
# Optional: override the OData entity set (default A_Incident, per SAP's
# EHS incident integration guide).
# SAP_API_ENTITY_SET=
